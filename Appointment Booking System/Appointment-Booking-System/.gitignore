# Dependencies
vendor/
node_modules/

# Local environment & databases
.env
*.sqlite
*.log

# Laravel generated files
laravel-app/bootstrap/cache/*.php
laravel-app/storage/framework/cache/data/*
laravel-app/storage/framework/sessions/*
laravel-app/storage/framework/views/*
laravel-app/storage/logs/*

# User uploads
php-app/uploads/*
!php-app/uploads/.htaccess
laravel-app/storage/app/private/*
